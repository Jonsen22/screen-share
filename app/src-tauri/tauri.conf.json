{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "screen-share",
  "version": "2.3.0",
  "identifier": "com.jonsen22.screenshare",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "screen-share",
        "width": 1120,
        "height": 720,
        "minWidth": 780,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self'; media-src 'self' blob: mediastream:; connect-src 'self' https: http: wss: ws: ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0NThGN0M5RTVGRjhCRDkKUldUWmkvL2x5ZmRZUkFvZ2FTRXRKWHYvMEZvWDk4dHF4R1lrRW9UQUdxK2JadzljdzZFTHRjQ28K",
      "endpoints": [
        "https://github.com/Jonsen22/screen-share/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
